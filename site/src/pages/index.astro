---
import Base from '../layouts/Base.astro';
import Seo from '../components/Seo.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import MediaLabel from '../components/MediaLabel.astro';
import BookingForm from '../components/BookingForm.astro';
import KprSimulator from '../components/KprSimulator.svelte';
import Gallery from '../components/Gallery.svelte';
import { site, waLink, waMessages } from '../data/site';
import { mediaAttrs } from '../lib/media';

const p = site.pricing;

const rupiah = new Intl.NumberFormat('id-ID', {
  style: 'currency',
  currency: 'IDR',
  maximumFractionDigits: 0,
});

/*
  The gallery carries what the media library actually holds. Reading the
  files (see src/data/media.ts) showed that only two of them are photographs
  of this project — the access road and the aerial of the land — and the
  rest are architectural visualisations. F6 used to put an honest label chip
  on every render; the owner removed those labels site-wide in Nov 2026, so
  each caption now names plainly what is shown.
*/
const galleryShots = [
  {
    key: '/media/curated/design-45.webp',
    alt: 'Tampak depan unit Valley Cityview tipe 45/72 di sore hari, dengan lembah di belakang',
    caption: 'Tampak depan unit tipe 45/72, sore hari',
    span: 'wide' as const,
  },
  {
    key: '/media/curated/hero.webp',
    alt: 'Ruang keluarga unit Valley Cityview dengan jendela lebar menghadap lembah',
    caption: 'Ruang keluarga, menghadap lembah',
  },
  {
    key: '/media/curated/design-24.webp',
    alt: 'Halaman depan unit Valley Cityview tipe 45/72',
    caption: 'Halaman depan dan carport',
  },
  {
    key: '/media/curated/unit-3.webp',
    alt: 'Dapur unit Valley Cityview yang terbuka ke taman belakang',
    caption: 'Dapur terbuka ke taman',
  },
  {
    key: '/media/curated/knowledge-1.webp',
    alt: 'Jalan utama di dalam kawasan Valley Cityview',
    caption: 'Jalan utama di dalam kawasan',
    span: 'wide' as const,
  },
  {
    key: '/media/curated/hero-2.webp',
    alt: 'Kamar tidur unit Valley Cityview dengan jendela ke taman',
    caption: 'Kamar tidur, menghadap taman',
  },
  {
    key: '/media/curated/design-25.webp',
    alt: 'Belakang unit Valley Cityview dengan carport dan kanopi',
    caption: 'Belakang unit dan carport',
  },
  {
    key: '/media/curated/hero-3.webp',
    alt: 'Ruang kerja di dalam unit Valley Cityview',
    caption: 'Ruang kerja di dalam unit',
  },
  {
    key: '/media/curated/detail-5.webp',
    alt: 'Lahan Valley Cityview di Laksanamekar dilihat dari udara, bersebelahan dengan jalan tol',
    caption: 'Lahan proyek, dilihat dari udara',
    span: 'wide' as const,
  },
].map((shot) => ({
  ...shot,
  ...mediaAttrs(shot.key),
}));

const faqs = [
  {
    q: 'Bisa dicicil? Berapa lama tenor KPR-nya?',
    a: 'Bisa. Dengan tenor 20 tahun dan suku bunga sekitar 4,75 %, cicilannya sekitar Rp 3.871.000 per bulan untuk harga Rp 599 juta. Tenor bisa disesuaikan dengan profil bank Anda.',
  },
  {
    q: 'Berapa luas tanah dan bangunan unitnya?',
    a: 'Tipe 45/72: 45 m² luas bangunan di atas 72 m² lahan, 2 kamar tidur, 1 kamar mandi, carport, dapur terbuka, dan jendela lebar menghadap panorama.',
  },
  {
    q: 'Berapa booking fee-nya?',
    a: 'Rp 5 juta, dan bisa dicicil. Uang ini yang menahan unit untuk Anda sementara proses KPR berjalan — bukan biaya tambahan di luar harga rumah.',
  },
  {
    q: 'Seberapa jauh ke stasiun KCIC dan kampus Unjani?',
    a: 'Sekitar 15 menit ke Stasiun Kereta Cepat Padalarang, sekitar 10 menit ke Kampus Unjani Cimahi, dan sekitar 15 menit ke Tol Baros serta RS Dustira.',
  },
  {
    q: 'Apakah lahannya aman dari genangan air?',
    a: 'Lahan berada di ketinggian di kaki perbukitan — area yang tidak pernah tergenang air. Itulah yang membuat harga tanah di sini relatif stabil.',
  },
  {
    q: 'Kapan unitnya siap dihuni?',
    a: 'Sebagian unit sudah siap huni, sebagian lagi masih dalam tahap finishing. Saat Anda menghubungi kami, kami akan informasikan unit mana yang tersedia dan bisa Anda lihat langsung.',
  },
];
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Residence',
    name: 'Valley Cityview',
    description: site.description,
    url: site.origin,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      addressRegion: site.address.region,
      postalCode: site.address.postalCode,
      addressCountry: site.address.country,
    },
    numberOfAccommodationUnits: 1,
    petsAllowed: false,
    amenityFeature: [
      { '@type': 'LocationFeatureSpecification', name: 'Panorama lembah hijau', value: true },
      { '@type': 'LocationFeatureSpecification', name: 'Carport', value: true },
      { '@type': 'LocationFeatureSpecification', name: 'Halaman depan dan belakang', value: true },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Unit Rumah Valley Cityview Tipe 45/72',
    description:
      'Rumah tipe 45/72 m² di Laksanamekar, Padalarang, Cimahi. 2 kamar tidur, 1 kamar mandi, carport, halaman depan dan belakang.',
    brand: { '@type': 'Brand', name: 'Valley Cityview' },
    offers: {
      '@type': 'Offer',
      price: p.kprPrice,
      priceCurrency: 'IDR',
      availability: 'https://schema.org/LimitedAvailability',
      priceValidUntil: '2027-12-31',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'Valley Cityview',
    url: site.origin,
    telephone: site.contact.phone,
    email: site.contact.email,
    priceRange: 'Rp 599.000.000',
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      addressRegion: site.address.region,
      addressCountry: site.address.country,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: -6.821,
      longitude: 107.546,
    },
    openingHours: 'Mo-Sa 09:00-18:00',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<Base
  title="Perumahan Valley Cityview di Cimahi — Rumah 45/72 dari Rp 599 Juta"
  description="Valley Cityview, perumahan tipe 45/72 m² di Laksanamekar, Padalarang, Cimahi. 15 menit ke KCIC, panorama lembah hijau, KPR Rp 599 juta, cicilan Rp 3.871.000 per bulan."
  path="/"
  image="/media/curated/design-45.webp"
  schemas={schemas}
  overlay
>
  <Seo
    slot="head"
    title="Perumahan Valley Cityview di Cimahi — Rumah 45/72 dari Rp 599 Juta"
    description="Valley Cityview, perumahan tipe 45/72 m² di Laksanamekar, Padalarang, Cimahi. 15 menit ke KCIC, panorama lembah hijau, KPR Rp 599 juta, cicilan Rp 3.871.000 per bulan."
    path="/"
    image="/media/curated/hero-unit-depan.webp"
    schemas={schemas}
  />

  <!-- ================= HERO ================= -->
  <section class="hero">
    <!--
      Slider dua slide, keduanya FOTO ASLI unit yang sudah berdiri
      (foto-1..2, sumbangan owner Nov 2026 — diverifikasi visual: bersih
      tanpa teks). Poster pemasaran "READY STOCK!" (image/WhatsApp
      2026-11-05) TIDAK dipakai di hero — ia materi promosi berteks dan
      kini tampil di section Tentang atas permintaan owner (lihat
      media-kinds.json: promo-ready).

      Zero-JS: rotasi murni CSS (@keyframes heroSlide, indeks via
      --i di style attribute). Sumber portrait asli hanya 903/1207 px
      lebar: di box desktop ia ter-upscale jadi blur dan frame habis di
      langit. Maka desktop memakai crop pita-rumah (hero-unit-*.webp,
      rasio ~1.74:1 sesuai box) dan phone memakai portrait penuh yang
      di-re-encode tajam (hero-unit-*-mobile.webp) lewat <source>.
      Slide 0 = tampak depan (foto-2, paling tajam & rumahnya dominan);
      ia juga slide yang tampil di perangkat Reduce Motion.
    -->
    <div class="hero__media">
      <div class="hero__slide" style="--i:0">
        <Picture
          name="/media/curated/hero-unit-depan.webp"
          mobileName="/media/curated/hero-unit-depan-mobile.webp"
          pictureClass="hero__picture"
          alt="Foto tampak depan unit Valley Cityview yang sudah berdiri: mobil di carport baja, taman kecil dan jendela ruang keluarga menyala sore"
          class="hero__img"
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero__slide" style="--i:1" aria-hidden="true">
        <Picture
          name="/media/curated/hero-unit-carport.webp"
          mobileName="/media/curated/hero-unit-carport-mobile.webp"
          pictureClass="hero__picture"
          alt=""
          class="hero__img"
          sizes="100vw"
          loading="lazy"
        />
      </div>
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <span class="hero__progress" aria-hidden="true"><i></i><i></i></span>

    <div class="shell hero__inner">
      <p class="hero__eyebrow">
        <span class="hero__dot"></span>
        Padalarang · Cimahi · Bandung Barat
      </p>

      <h1 class="hero__title">
        Dari ketinggian,<br />
        segalanya <em>terlihat lebih jelas.</em>
      </h1>

      <div class="hero__actions">
        <a
          class="btn btn--accent btn--lg"
          href={waLink(waMessages.booking)}
          data-wa="hero"
        >
          <Icon name="whatsapp" size={19} />
          Amankan unit Anda
        </a>
      </div>
    </div>

    <a class="hero__scroll" href="#tentang" aria-label="Gulir ke bawah">
      <span class="hero__scroll-line" aria-hidden="true"></span>
      <span class="hero__scroll-text">Gulir</span>
    </a>
  </section>

  <!-- ================= OFFER BAND =================
     Owner 13 Nov: hero dibersihkan — foto dulu, teks sedikit. Lead,
     harga, trust point, dan tombol sekunder pindah ke sini (band gelap
     tepat di bawah hero); proof bar lama dibuang karena angkanya
     duplikat dengan isi band ini (15/10 menit ada di lead, 45/72 dan
     booking ada di kartu harga). -->
  <section class="offer" aria-label="Harga dan keunggulan">
    <div class="shell offer__inner">
      <div class="offer__text" data-reveal>
        <p class="offer__lead">
          Rumah 45/72 m² di Laksanamekar, Padalarang — menghadap lembah
          hijau, 15 menit ke Stasiun KCIC, dan 10 menit ke kampus Unjani
          Cimahi.
        </p>
        <ul class="offer__trust">
          <li><Icon name="check" size={15} /> 2 kamar tidur + 1 kamar mandi</li>
          <li><Icon name="check" size={15} /> Carport & halaman depan/belakang</li>
          <li><Icon name="check" size={15} /> Bebas banjir</li>
        </ul>
        <a class="btn btn--light" href="#unit">
          Lihat denah &amp; spesifikasi
          <Icon name="arrowRight" size={18} />
        </a>
      </div>

      <div class="offer__price" data-reveal style="--reveal-delay:120ms">
        <div class="offer__price-item offer__price-item--lead">
          <span class="offer__price-label">Harga KPR</span>
          <span class="offer__price-value">{rupiah.format(p.kprPrice)}</span>
        </div>
        <div class="offer__price-item">
          <span class="offer__price-label">Cicilan</span>
          <span class="offer__price-value">
            {rupiah.format(p.monthly)}<small>/bulan</small>
          </span>
        </div>
        <div class="offer__price-item">
          <span class="offer__price-label">Booking</span>
          <span class="offer__price-value">Rp 5 juta<small>bisa dicicil</small></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TENTANG ================= -->
  <section class="section" id="tentang">
    <div class="contour" aria-hidden="true"></div>
    <div class="shell about">
      <div class="about__text" data-reveal>
        <p class="eyebrow">Tentang Valley Cityview</p>
        <h2>
          Rumah bukan hanya bangunan,<br />
          tapi cara kita <em>memandang hidup.</em>
        </h2>
        <p class="about__lead">
          Bayangkan Anda bangun pagi: udara pegunungan masuk lewat jendela besar,
          dan yang pertama terlihat adalah lembah hijau, bukan tembok tetangga.
        </p>
        <p>
          Valley Cityview berdiri di Desa Laksanamekar, Padalarang — sekitar 15
          menit ke Stasiun Kereta Cepat Padalarang dan 10 menit ke kampus Unjani
          Cimahi. Yang kami tawarkan sengaja sederhana: satu tipe yang matang,
          satu harga yang masuk akal, dan satu unit yang bisa Anda lihat
          langsung sebelum memutuskan.
        </p>

        <div class="about__points">
          <div class="about__point">
            <span class="about__point-icon"><Icon name="leaf" size={20} /></span>
            <div>
              <h3>Dingin dan sejuk secara alami</h3>
              <p>
                Jendela besar dan aliran udara terbuka membuat rumah terasa adem
                tanpa harus bergantung penuh pada AC.
              </p>
            </div>
          </div>
          <div class="about__point">
            <span class="about__point-icon"><Icon name="mapPin" size={20} /></span>
            <div>
              <h3>Tidak ada hari yang terasa terputus</h3>
              <p>
                Dekat KCIC, Tol Baros, dan RS Dustira — cukup dekat untuk
                komuter, cukup jauh untuk tinggal yang tenang
              </p>
            </div>
          </div>
          <div class="about__point">
            <span class="about__point-icon"><Icon name="banknote" size={20} /></span>
            <div>
              <h3>Harga yang masuk akal</h3>
              <p>
                Rp 599 juta dengan cicilan sekitar Rp 3,8 juta per bulan —
                dihitung dengan perhitungan yang benar.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="about__media" data-reveal>
        <div class="about__frame">
          <!-- Permintaan owner (12 Nov 2026): slot Tentang memakai poster
               promosi "RUMAH READY STOCK! DP 0% CICILAN 2 JUTAAN"
               (image/WhatsApp 2026-11-05). Ini materi promosi, bukan foto
               unit — kind `poster` di media-kinds.json. aspect-ratio 4/5
               mengikuti poster agar teks atas dan bawah tidak terpotong. -->
          <Picture
            name="/media/curated/promo-ready.webp"
            alt="Poster promosi Valley Cityview: rumah ready stock, DP 0 persen, cicilan 2 jutaan — ajak jadwal survey"
            class="about__img"
            sizes="(max-width: 900px) 100vw, 45vw"
          />
          <MediaLabel name="/media/curated/promo-ready.webp" />
        </div>
        <div class="about__badge">
          <span class="about__badge-value">15</span>
          <span class="about__badge-label">menit ke<br />Stasiun KCIC</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= UNIT & DENAH ================= -->
  <section class="section section--alt" id="unit">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Tipe Unit</p>
        <h2>Satu tipe, dirancang untuk keluarga yang baru memulai</h2>
        <p>
          Tidak banyak pilihan, tapi semuanya dipilih dengan pertimbangan yang matang.
          Denahnya ada di sini — mari kita periksa bersama.
        </p>
      </div>

      <div class="unit">
        <div class="unit__plans" data-reveal>
          {
            [
              {
                key: '/media/curated/denah-45-72.webp',
                label: 'Denah Tipe 45 / 72',
                alt: 'Denah rumah tipe 45/72 Valley Cityview: dua kamar tidur, satu kamar mandi, dapur terbuka, ruang makan, carport, halaman depan dan halaman belakang',
              },
            ].map((plan) => {
              const entry = mediaAttrs(plan.key);
              return (
                <a
                  class="unit__plan"
                  href={entry.src}
                  target="_blank"
                  rel="noopener"
                  title="Buka denah ukuran penuh"
                >
                  <Picture
                    name={plan.key}
                    alt={plan.alt}
                    class="unit__plan-img"
                    sizes="(max-width: 900px) 100vw, 40vw"
                  />
                  <span class="unit__plan-caption">
                    {plan.label}
                    <Icon name="download" size={15} />
                  </span>
                </a>
              );
            })
          }
        </div>

        <div class="unit__specs" data-reveal>
          <h3 class="unit__specs-title">Spesifikasi unit</h3>
          <ul class="spec-list">
            <li>
              <Icon name="ruler" size={18} />
              <span><strong>Luas bangunan 45 m²</strong> · luas lahan 72 m²</span>
            </li>
            <li>
              <Icon name="bed" size={18} />
              <span><strong>2 kamar tidur</strong> + 1 kamar mandi</span>
            </li>
            <li>
              <Icon name="home" size={18} />
              <span><strong>Carport</strong> dengan halaman depan dan belakang</span>
            </li>
            <li>
              <Icon name="spark" size={18} />
              <span><strong>Jendela besar</strong> dan pencahayaan alami</span>
            </li>
            <li>
              <Icon name="layers" size={18} />
              <span><strong>Dapur terbuka</strong> ke taman belakang</span>
            </li>
            <li>
              <Icon name="shield" size={18} />
              <span><strong>Bebas banjir</strong> — area di ketinggian</span>
            </li>
          </ul>

          <div class="price-card">
            <div class="price-card__row">
              <span>Harga KPR</span>
              <strong>{rupiah.format(p.kprPrice)}</strong>
            </div>
            <div class="price-card__row">
              <span>Cicilan</span>
              <strong>
                {rupiah.format(p.monthly)}<small>/bulan</small>
              </strong>
            </div>
            <div class="price-card__row">
              <span>Tenor</span>
              <strong>{p.tenureYears} tahun</strong>
            </div>
            <div class="price-card__row">
              <span>Booking fee</span>
              <strong>Rp 5.000.000</strong>
            </div>
            <a
              class="btn btn--accent btn--block"
              href={waLink(waMessages.booking)}
              data-wa="price-card"
            >
              <Icon name="whatsapp" size={18} />
              Booking unit Rp 5 juta
            </a>
            <p class="price-card__note">
              Angka cicilan memakai perhitungan bunga tetap 4,75 %/tahun.
              <a href="/simulasi-kpr/">Hitung sendiri →</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PANORAMA ================= -->
  <section class="section section--dark" id="panorama">
    <div class="contour" aria-hidden="true"></div>
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Peta 360°</p>
        <h2>Di mana rumah bertemu panorama</h2>
        <p>
          Berjalan virtual di area Valley Cityview. Lihat sendiri posisi unit,
          arah mata angin, dan seberapa jauh Panorama membentang.
        </p>
      </div>

      <div class="panorama" data-reveal>
        <iframe
          height="550"
          width="100%"
          allowfullscreen="true"
          src="https://momento360.com/e/u/336ef22f2f3c4439aa123deaa6d706de?utm_campaign=embed&utm_source=other&heading=-0.2&pitch=-11.7&field-of-view=75&size=medium&autoplay-annotations=true&display-plan=true"
          title="Panorama 360 derajat Valley Cityview"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ================= GALERI ================= -->
  <section class="section" id="galeri">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Galeri Proyek</p>
        <!--
          F6: the heading used to promise "kondisi unit" — the actual
          condition of a built house — over a wall of visualisations. The
          labels on the tiles would have contradicted the sentence above
          them, so the sentence changed instead of the labels.
        -->
        <h2>Denah saja tidak cukup — lihat gambaran ruangannya</h2>
        <p>
          Sebagian gambar adalah foto lokasi, sebagian lagi visualisasi
          arsitektur — keterangan tiap gambar menjelaskan apa yang terlihat.
          Ketuk gambar untuk memperbesar.
        </p>
      </div>

      <div data-reveal>
        <Gallery client:visible shots={galleryShots} />
      </div>
    </div>
  </section>

  <!-- ================= LOKASI ================= -->
  <section class="section section--alt" id="lokasi">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Lokasi &amp; Akses</p>
        <h2>Cukup dekat untuk bekerja, cukup jauh untuk tenang</h2>
        <p>
          Desa Laksanamekar, Padalarang, Cimahi — di kaki perbukitan, menghadap
          lembah.
        </p>
      </div>

      <figure class="location-photo" data-reveal>
        <Picture
          name="/media/curated/detail-5.webp"
          alt="Lahan Valley Cityview di Laksanamekar, Padalarang, dilihat dari udara, bersebelahan dengan Jalan Tol Padalarang"
          class="location-photo__img"
          sizes="(max-width: 900px) 100vw, 1100px"
        />
        <figcaption>
          Lahan Valley Cityview di Laksanamekar — menghadap lembah, dengan
          jalan tol Padalarang di sisi timur.
        </figcaption>
      </figure>

      <div class="access">
        {
          [
            {
              icon: 'train' as const,
              place: 'Stasiun KCIC Padalarang',
              time: '± 15 menit',
              note: 'Kereta cepat menuju Bandung dan sekitarnya',
            },
            {
              icon: 'mapPin' as const,
              place: 'Kampus Unjani Cimahi',
              time: '± 10 menit',
              note: 'Untuk yang bekerja atau kuliah di Cimahi',
            },
            {
              icon: 'phone' as const,
              place: 'Tol Baros & RS Dustira',
              time: '± 15 menit',
              note: 'Akses keluar-masuk kota tetap lancar',
            },
            {
              icon: 'leaf' as const,
              place: 'Lahan di ketinggian',
              time: 'Di kawasan sini',
              note: 'Lahan di ketinggian, aman dari genangan air',
            },
          ].map((item, i) => (
            <div class="access__item" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="access__icon">
                <Icon name={item.icon} size={20} />
              </span>
              <div>
                <h3>{item.place}</h3>
                <p class="access__time">{item.time}</p>
                <p class="access__note">{item.note}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="location-cta" data-reveal>
        <div>
          <h3>Ingin melihat sendiri?</h3>
          <p>
            Kunjungi lokasi, lihat unit yang tersedia, dan rasakan sendiri
            udaranya. Kami siapkan jadwalnya.
          </p>
        </div>
        <a
          class="btn btn--accent"
          href={waLink(waMessages.booking)}
          data-wa="location"
        >
          <Icon name="calendar" size={18} />
          Jadwalkan kunjungan
        </a>
      </div>
    </div>
  </section>

  <!-- ================= SIMULASI KPR ================= -->
  <section class="section" id="kpr">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Simulasi KPR</p>
        <h2>Coba geser sendiri angkanya</h2>
        <p>
          Ubah uang muka, tenor, dan suku bunga. Angka di sini memakai
          perhitungan yang sama seperti yang kami tawarkan.
        </p>
      </div>

      <div data-reveal>
        <KprSimulator client:visible />
      </div>
    </div>
  </section>

  <!-- ================= FAQ ================= -->
  <section class="section section--alt" id="faq">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Pertanyaan Umum</p>
        <h2>Yang biasanya ditanyakan calon pembeli</h2>
      </div>

      <div class="faq" data-reveal>
        {
          faqs.map((item) => (
            <details class="faq__item">
              <summary>
                <span>{item.q}</span>
                <span class="faq__plus" aria-hidden="true" />
              </summary>
              <div class="faq__answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= BOOKING ================= -->
  <section class="section" id="booking">
    <div class="contour" aria-hidden="true"></div>
    <div class="shell booking-wrap">
      <div class="booking-wrap__text" data-reveal>
        <p class="eyebrow">Booking Sekarang</p>
        <h2>Ambil satu langkah kecil hari ini</h2>
        <p>
          Hunian tipe 45/72 di Laksanamekar, Padalarang — 15 menit ke KCIC,
          menghadap lembah hijau. Unitnya terbatas, dan booking fee-nya hanya
          Rp 5 juta.
        </p>

        <ul class="booking-wrap__points">
          <li>
            <span class="booking-wrap__check"><Icon name="check" size={15} /></span>
            Unit langsung dikunci saat booking fee dibayar
          </li>
          <li>
            <span class="booking-wrap__check"><Icon name="check" size={15} /></span>
            Booking fee bisa dicicil
          </li>
          <li>
            <span class="booking-wrap__check"><Icon name="check" size={15} /></span>
            Kami siapkan jadwal kunjungan ke lokasi
          </li>
          <li>
            <span class="booking-wrap__check"><Icon name="check" size={15} /></span>
            Tersedia simulasi KPR dengan dukungan bank rekanan
          </li>
        </ul>

        <div class="booking-wrap__contact">
          <a
            class="btn btn--wa"
            href={waLink(waMessages.booking)}
            data-wa="booking-section"
          >
            <Icon name="whatsapp" size={18} />
            Chat WhatsApp
          </a>
          <span class="booking-wrap__hours">
            <Icon name="clock" size={15} />
            {site.contact.hours}
          </span>
        </div>
      </div>

      <div class="booking-wrap__form" data-reveal>
        <BookingForm />
      </div>
    </div>
  </section>
</Base>

<style>

  /* ---------------- Hero ---------------- */
  .hero {
    position: relative;
    min-height: 92svh;
    display: flex;
    align-items: flex-end;
    /* The header is sticky, so it occupies the flow and the picture started
       below it — the "overlay" bar was then washing the pale page background
       instead of the photo, and the white nav sat at 1.9:1. Pulling the hero
       up under the bar is what makes the overlay an overlay; the padding
       below keeps the copy clear of it. */
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + 1.5rem);
    padding-bottom: var(--s-7);
    overflow: hidden;
    isolation: isolate;
  }


  /* Mobile: ruang ekstra di atas supaya chip lokasi tidak menempel nav
     saat hero masih di posisi awal (header overlay transparan). */
  @media (max-width: 899px) {
    .hero {
      padding-top: calc(var(--header-h) + 3.6rem);
    }
  }


  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* F6: the hero picture is a visualisation and used to say so on the
     picture itself with a spelled-out note. The owner removed those labels
     in Nov 2026; the rule stays for any future note pinned to the hero. */
  .hero__note {
    position: absolute;
    /* Sits under the sticky bar now that the hero runs up behind it. It used
       to be 0.75rem because the hero started *below* the header; with the
       overlay working, that placed it behind the nav. */
    top: calc(var(--header-h) + 0.75rem);
    right: var(--gutter);
    z-index: 2;
    padding: 0.28rem 0.6rem;
    border-radius: var(--r-full);
    background: color-mix(in srgb, var(--brand-900) 72%, transparent);
    border: 1px solid color-mix(in srgb, var(--white) 22%, transparent);
    color: var(--white);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Slider hero murni CSS — keyframes heroSlide/heroKenburns lives in
     styles/media.css karena ia menggerakkan .hero__img yang dirender
     Picture.astro (rule scoped di halaman ini tidak bisa menyeberang ke
     dalam komponen). */

  /*
    Permintaan owner 12 Nov 2026 (kedua): "hero ancur, foto ga ada" —
    scrim versi sebelumnya (88% di tiga lapisan) menutup foto sampai
    terlihat seperti bidang teal polos. Kini scrim jauh lebih ringan dan
    HANYA berkumpul di kolom kiri tempat kata tinggal; separuh kanan
    (rumah) dibiarkan bersih supaya foto terbaca sebagai foto.

    Keterbacaan dibantu text-shadow di .hero__title (bukan menggelapkan
    seluruh foto). Angka tetap diukur audit-contrast (worst-5%
    white-on-photo, gate 3:1) — kalau longgar tidak lolos,
    yang dinaikkan adalah gradien kiri/text-shadow, bukan kabut global.

    Landing nup/sale/agent tetap memakai token penuh --scrim-hero di
    global.css; mereka diukur terpisah dan belum berubah.
  */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      /* kiri — kolom kata; berhenti di 62% lebar agar rumah kanan bersih */
      linear-gradient(to right,
        color-mix(in srgb, var(--brand-900) 66%, transparent) 0%,
        color-mix(in srgb, var(--brand-900) 40%, transparent) 34%,
        color-mix(in srgb, var(--brand-900) 12%, transparent) 52%,
        transparent 62%),
      /* atas tipis — hanya untuk nav + eyebrow, bukan langit penuh */
      linear-gradient(to bottom,
        color-mix(in srgb, var(--brand-900) 46%, transparent) 0%,
        transparent 26%),
      /* pita kata mobile: sejak 13 Nov isi hero tinggal chip + judul +
         satu tombol yang duduk MELENDOK di bawah (flex-end); judul kini
         menempati 66-84% hero, baris terakhir di atas paving terang —
         pita digeser ke 48-96% dan dipadatkan (audit kontras mobile
         menuntutnya, bukan selera). Fasad atas rumah tetap bersih. */
      linear-gradient(to bottom,
        transparent 48%,
        color-mix(in srgb, var(--brand-900) 60%, transparent) 62%,
        color-mix(in srgb, var(--brand-900) 56%, transparent) 88%,
        transparent 96%),
      /* bawah tipis — tombol + progress, rumah tetap terbaca */
      linear-gradient(to top,
        color-mix(in srgb, var(--brand-900) 52%, transparent) 0%,
        transparent 30%);
  }

  /* Desktop: rumah di kuadran kanan-bawah; cukup sapuan kiri yang lebih
     pendek + atas/bawah tipis. Mobile (basis di atas) memakai gradien
     kiri yang lebih lebar karena headline jatuh di langit penuh lebar. */
  @media (min-width: 900px) {
    .hero__scrim {
      background:
        linear-gradient(to right,
          color-mix(in srgb, var(--brand-900) 62%, transparent) 0%,
          color-mix(in srgb, var(--brand-900) 34%, transparent) 30%,
          color-mix(in srgb, var(--brand-900) 10%, transparent) 46%,
          transparent 56%),
        linear-gradient(to bottom,
          color-mix(in srgb, var(--brand-900) 40%, transparent) 0%,
          transparent 24%),
        linear-gradient(to top,
          color-mix(in srgb, var(--brand-900) 46%, transparent) 0%,
          transparent 26%);
    }
  }

  /* Indikator rotasi: dua titik, menyala bergantian sinkron dengan slide
     (satu siklus 16s, tiap titik aktif 8s). */
  .hero__progress {
    position: absolute;
    right: var(--gutter);
    bottom: var(--s-6);
    display: flex;
    gap: 0.5rem;
    z-index: 2;
  }

  .hero__progress i {
    width: 22px;
    height: 3px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--white) 30%, transparent);
    overflow: hidden;
    position: relative;
  }

  .hero__progress i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent-500);
    transform-origin: left;
    animation: heroTick 12s linear infinite both;
  }

  .hero__progress i:nth-child(2)::after { animation-delay: 6s; }

  @keyframes heroTick {
    /* Tiap titik penuh selama masanya (6s dari 12s = 50%), lalu kosong.
       1% = durasi fade-in slide agar tidak ada frame kosong. */
    0% { transform: scaleX(0); }
    1%, 50% { transform: scaleX(1); }
    51%, 100% { transform: scaleX(0); }
  }

  /* Micro-animation masuknya copy: satu keyframe, stagger per elemen.
     Ini yang menjawab "animasi micro ga ada" tanpa menambah JS. */
  @keyframes heroRise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero__inner > * {
    animation: heroRise 0.7s var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
  }

  .hero__inner > :nth-child(2) { animation-delay: 0.08s; }
  .hero__inner > :nth-child(3) { animation-delay: 0.16s; }
  .hero__inner > :nth-child(4) { animation-delay: 0.24s; }
  .hero__inner > :nth-child(5) { animation-delay: 0.32s; }
  .hero__inner > :nth-child(6) { animation-delay: 0.4s; }

  /* Kartu harga di offer band — micro-interaction hover ikut pindah
     bersama kontennya (13 Nov, hero clean). */
  .offer__price-item {
    transition: transform 0.25s var(--ease-out, ease);
  }

  .offer__price-item:hover {
    transform: translateY(-3px);
  }

  /* ---- Micro-animation yang benar-benar terlihat (12 Nov 2026) ----
     Sebelumnya hanya heroRise sekali saat load — setelah itu layar diam,
     sehingga terasa "tidak ada animasi". Kini tiga denyut halus yang
     terus hidup: dot lokasi, tombol WA, dan trust list masuk bergiliran.
     Semua murni CSS; prefers-reduced-motion di global.css mematikan. */

  /* Dot lokasi berdenyut seperti radar — sinyal "ini kawasan nyata". */
  .hero__dot {
    animation: heroDot 2.4s var(--ease-in-out, ease-in-out) infinite;
  }

  @keyframes heroDot {
    0%, 100% { box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-100) 22%, transparent); }
    50% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--brand-100) 6%, transparent); }
  }

  /* Tombol booking "bernapas" lewat glow kuning — satu-satunya aksen
     kuning di layar (F5), jadi denyutnya tidak berebut perhatian. */
  .hero__actions .btn--accent {
    animation: heroCta 3.2s var(--ease-in-out, ease-in-out) infinite;
  }

  @keyframes heroCta {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent-500) 42%, transparent); }
    50% { box-shadow: 0 0 26px 4px color-mix(in srgb, var(--accent-500) 30%, transparent); }
  }

  /* Micro-animation copy hero: chip + judul + tombol masuk bergiliran. */

  /* Ikon WA di tombol ikut berdenyut halus selaras glow tombol. */
  .hero__actions .btn--accent :global(svg) {
    animation: heroWa 3.2s var(--ease-in-out, ease-in-out) infinite;
  }

  @keyframes heroWa {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.12); }
  }


  .hero__inner {
    position: relative;
    width: 100%;
  }


  /* F5: one yellow per viewport, reserved for the booking action. The
     eyebrow, the dot and the italic headline all used to be accent yellow,
     which made the first screen shout four competing highlights.

     It also used to be pale brand-100 lettering floating straight onto the
     dusk sky — 1.7:1 in .review/cap/home/mobile/000-y0.png, unreadable. The
     location is a fact worth a badge, so it sits on solid brand-900 instead
     of on nothing. */
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.7rem 0.3rem 0.55rem;
    border-radius: var(--r-full);
    background: var(--brand-900);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--white);
    margin-bottom: var(--s-4);
  }


  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-100);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--brand-100) 18%, transparent);
  }


  .hero__title {
    /* --fs-h1, not --t-5xl and not a private clamp. The headline is an h1,
       so it is the size of every other h1 on the site — which is also what
       keeps it to three lines instead of four on a 390px screen. */
    font-size: var(--fs-h1);
    line-height: 1.06;
    color: var(--white);
    max-width: 15ch;
    margin-bottom: var(--s-4);
    /* scrim kini ringan (foto terbaca); bayangan teks menjaga huruf tetap
       terbaca di atas langit foto tanpa menggelapkan seluruh gambar. */
    text-shadow: 0 2px 18px color-mix(in srgb, var(--brand-900) 78%, transparent),
      0 1px 3px color-mix(in srgb, var(--brand-900) 60%, transparent);
  }


  .hero__title em {
    font-style: italic;
    color: var(--white);
    font-variation-settings: 'SOFT' 40, 'WONK' 1;
  }


  /* ---------------- Offer band ----------------
     Pemindahan isi hero (13 Nov). Band gelap persis di bawah foto:
     lead + trust + tombol denah di kiri, kartu harga di kanan. Mobile:
     menumpuk, lead 2–3 baris, harga 1 besar + 2 kolom — compact agar
     scroll hemat. */
  .offer {
    background: var(--brand-900);
    color: var(--white);
    padding-block: var(--s-6);
    border-top: 1px solid color-mix(in srgb, var(--white) 10%, transparent);
  }


  .offer__inner {
    display: grid;
    gap: var(--s-5);
  }


  .offer__lead {
    font-size: var(--t-base);
    line-height: 1.6;
    color: color-mix(in srgb, var(--white) 88%, transparent);
    max-width: 46ch;
    margin: 0 0 var(--s-4);
  }


  .offer__trust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem var(--s-4);
    list-style: none;
    margin: 0 0 var(--s-5);
    padding: 0;
    font-size: var(--t-sm);
    color: color-mix(in srgb, var(--white) 78%, transparent);
  }


  .offer__trust li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }


  .offer__trust :global(svg) {
    color: var(--brand-100);
    flex: none;
  }


  .offer__price {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4) var(--s-3);
    padding: var(--s-4);
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--white) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--white) 14%, transparent);
  }


  .offer__price-item {
    display: grid;
    gap: 0.1rem;
    align-content: start;
  }


  .offer__price-item--lead {
    grid-column: 1 / -1;
    padding-bottom: var(--s-3);
    border-bottom: 1px solid color-mix(in srgb, var(--white) 18%, transparent);
  }


  .offer__price-label {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-100);
  }


  .offer__price-value {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 700;
    color: var(--white);
    white-space: nowrap;
  }


  .offer__price-value small {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--t-xs);
    font-weight: 500;
    color: var(--brand-100);
    letter-spacing: 0.02em;
  }


  /* Full-width buttons on a phone: two labels of different lengths used to
     leave a ragged right edge with one button overhanging the other. */
  .hero__actions {
    display: grid;
    gap: var(--s-3);
  }


  .hero__scroll {
    position: absolute;
    bottom: var(--s-5);
    right: max(var(--gutter), calc((100vw - var(--max-w)) / 2 + var(--gutter)));
    display: none;
    align-items: center;
    gap: 0.6rem;
    color: color-mix(in srgb, var(--white) 70%, transparent);
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
  }


  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 46px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--white) 70%, transparent)
    );
    position: relative;
    overflow: hidden;
  }


  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 40%;
    /* Pale teal, not the accent: F5 keeps the only yellow on this screen for
       the booking button. */
    background: var(--brand-100);
    animation: scrollHint 2.1s var(--ease-in-out) infinite;
  }
@keyframes scrollHint {

    0% {
      transform: translateY(-100%);
    }

    100% {
      transform: translateY(250%);
    }
}


  /* ---------------- About ---------------- */
  .about {
    display: grid;
    gap: var(--s-7);
    position: relative;
  }


  .about h2 em {
    font-style: italic;
    color: var(--brand-600);
  }


  .about__lead {
    font-size: var(--t-lg);
    color: var(--ink-800) !important;
  }


  .about__text > p {
    color: var(--ink-600);
    max-width: 56ch;
  }


  /* Three loose stacked features used to run past a full screen on a phone.
     Hairline rows keep the same order and fit it. */
  .about__points {
    display: grid;
    gap: 0;
    margin-top: var(--s-5);
    border-top: 1px solid var(--border);
  }


  .about__point {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--border);
  }


  .about__point-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--r-md);
    background: var(--brand-050);
    color: var(--brand-700);
  }


  .about__point h3 {
    font-size: var(--fs-h3);
    margin-bottom: 0.15rem;
  }


  .about__point p {
    font-size: var(--t-sm);
    color: var(--ink-600);
    margin: 0;
  }


  .about__media {
    position: relative;
  }


  /* Hairline, not a drop shadow — the vision keeps cards flat. */
  .about__frame {
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--brand-900);
  }


  .about__badge {
    position: absolute;
    left: -0.75rem;
    bottom: -0.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.1rem;
    /* Flat chip, hairline, no shadow, no second accent (C6 + F5). */
    background: var(--brand-900);
    color: var(--white);
    border: 1px solid var(--brand-700);
    border-radius: var(--r-lg);
  }


  .about__badge-value {
    font-family: var(--font-display);
    font-size: var(--t-3xl);
    font-weight: 700;
    line-height: 1;
  }


  .about__badge-label {
    font-size: var(--t-xs);
    font-weight: 600;
    line-height: 1.3;
  }


  /* ---------------- Unit ---------------- */
  .unit {
    display: grid;
    gap: var(--s-6);
  }


  .unit__plans {
    display: grid;
    gap: var(--s-4);
  }


  .unit__plan {
    display: block;
    position: relative;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--border);
    transition:
      transform var(--d-base) var(--ease-out),
      box-shadow var(--d-base) var(--ease-out);
  }


  .unit__plan:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }


  .unit__plan-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    background: color-mix(in srgb, var(--white) 92%, transparent);
    backdrop-filter: blur(6px);
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--brand-800);
  }


  .unit__specs-title {
    font-size: var(--fs-h3);
    margin-bottom: var(--s-4);
  }


  .spec-list {
    list-style: none;
    margin: 0 0 var(--s-5);
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }


  .spec-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: var(--t-sm);
    color: var(--ink-600);
  }


  .spec-list :global(svg) {
    flex: none;
