---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { Page, PaginateFunction } from 'astro';
import Base from '../../layouts/Base.astro';
import Seo from '../../components/Seo.astro';
import Icon from '../../components/Icon.astro';
import Picture from '../../components/Picture.astro';
import MediaLabel from '../../components/MediaLabel.astro';
import { mediaCaption } from '../../data/media';
import { site, waLink, waMessages } from '../../data/site';

/**
 * The blog index, paginated.
 *
 * A rest parameter puts page one on /blog/ and the rest on /blog/2/,
 * /blog/3/ … — 12 articles per page instead of one 38,000-pixel column.
 */
export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const posts = (await getCollection('blog', ({ data }) => data.status === 'publish' && !data.redirectTo)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return paginate(posts, { pageSize: 12 });
}

const { page } = Astro.props as { page: Page<CollectionEntry<'blog'>> };
const posts = page.data;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);

const [featured, ...rest] = page.currentPage === 1 ? posts : [];
const cards = page.currentPage === 1 ? rest : posts;

const path = page.currentPage === 1 ? '/blog/' : `/blog/${page.currentPage}/`;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog Valley Cityview',
    description:
      'Panduan hunian di Cimahi, Padalarang, dan Bandung Barat — harga, cicilan KPR, akses, dan tips memilih rumah pertama.',
    url: `${site.origin}/blog/`,
    blogPost: posts.slice(0, 10).map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      datePublished: post.data.date.toISOString(),
      url: `${site.origin}/blog/${post.data.slug}/`,
      image: `${site.origin}${post.data.cover ?? '/media/curated/design-45.webp'}`,
    })),
  },
];
---

<Base
  title={page.currentPage === 1
    ? 'Blog Hunian di Cimahi & Padalarang'
    : `Blog Hunian di Cimahi & Padalarang — Halaman ${page.currentPage}`}
  description="Panduan memilih hunian di Cimahi, Padalarang, dan Bandung Barat — harga, cicilan KPR, akses, dan tips agar keputusan beli rumah tidak menyesal."
  path={path}
  schemas={schemas}
>
  <Seo
    slot="head"
    title={page.currentPage === 1
      ? 'Blog Hunian di Cimahi & Padalarang'
      : `Blog Hunian di Cimahi & Padalarang — Halaman ${page.currentPage}`}
    description="Panduan memilih hunian di Cimahi, Padalarang, dan Bandung Barat — harga, cicilan KPR, akses, dan tips agar keputusan beli rumah tidak menyesal."
    path={path}
    schemas={schemas}
  />

  <section class="section blog-head">
    <div class="contour" aria-hidden="true"></div>
    <div class="shell">
      <p class="eyebrow">Blog</p>
      <h1>Catatan Hunian di Cimahi dan sekitarnya</h1>
      <p class="blog-head__lead">
        Harga, cicilan, akses, dan hal-hal yang sering terlewat saat memilih
        hunian pertama.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      {
        featured && (
          <a class="featured" href={`/blog/${featured.data.slug}/`} data-reveal>
            <div class="featured__media">
              {featured.data.cover ? (
                <Picture
                  name={featured.data.cover}
                  alt={mediaCaption(featured.data.cover) ?? featured.data.title}
                  class="featured__img"
                  sizes="(max-width: 900px) 100vw, 55vw"
                />
              ) : (
                <div class="featured__placeholder">
                  <Icon name="layers" size={38} />
                </div>
              )}
              <span class="featured__badge">Artikel terbaru</span>
              {featured.data.cover && <MediaLabel name={featured.data.cover} />}
            </div>
            <div class="featured__body">
              <p class="featured__meta">
                <time datetime={featured.data.date.toISOString()}>
                  {formatDate(featured.data.date)}
                </time>
                <span>·</span>
                <span>5 menit baca</span>
              </p>
              <h2>{featured.data.title}</h2>
              <p>{featured.data.description}</p>
              <span class="featured__cta">
                Baca selengkapnya <Icon name="arrowRight" size={17} />
              </span>
            </div>
          </a>
        )
      }

      <!--
        F6: the featured cover above and the article page itself carry the
        "Ilustrasi" chip. The twelve thumbnails below do not — at 104px a chip
        is noise, and every one of them links to a page that does say it. The
        alt text still names what is visible (mediaCaption), so no thumbnail
        claims to be a photograph of a finished house.
      -->
      <div class="post-grid">
        {
          cards.map((post, i) => (
            <article class="post-card" data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
              <a class="post-card__link" href={`/blog/${post.data.slug}/`}>
                <div class="post-card__media">
                  {post.data.cover ? (
                    <Picture
                      name={post.data.cover}
                      alt={mediaCaption(post.data.cover) ?? post.data.title}
                      class="post-card__img"
                      sizes="(max-width: 560px) 30vw, (max-width: 1000px) 50vw, 33vw"
                    />
                  ) : (
                    <div class="post-card__placeholder">
                      <Icon name="layers" size={30} />
                    </div>
                  )}
                </div>
                <div class="post-card__body">
                  <p class="post-card__meta">
                    <time datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                  </p>
                  <h3>{post.data.title}</h3>
                  <p class="post-card__excerpt">{post.data.description}</p>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <nav class="pagination" aria-label="Halaman artikel">
        {
          page.url.prev ? (
            <a class="pagination__link" href={page.url.prev} rel="prev">
              <Icon name="arrowRight" size={16} />
              Sebelumnya
            </a>
          ) : (
            <span class="pagination__link is-disabled" aria-hidden="true" />
          )
        }
        <span class="pagination__status">
          Halaman {page.currentPage} dari {page.lastPage}
        </span>
        {
          page.url.next ? (
            <a class="pagination__link" href={page.url.next} rel="next">
              Berikutnya
              <Icon name="arrowRight" size={16} />
            </a>
          ) : (
            <span class="pagination__link is-disabled" aria-hidden="true" />
          )
        }
      </nav>
    </div>
  </section>

  <section class="section section--dark">
    <div class="contour" aria-hidden="true"></div>
    <div class="shell blog-cta" data-reveal>
      <div>
        <h2>Lebih suka langsung ngobrol?</h2>
        <p>
          Kirim pertanyaan Anda. Tim kami jawab dengan angka, unit yang tersedia,
          dan jadwal kunjungan — bukan brosur.
        </p>
      </div>
      <a class="btn btn--accent btn--lg" href={waLink(waMessages.general)} data-wa="blog-cta">
        <Icon name="whatsapp" size={19} />
        Chat {site.contact.whatsappDisplay}
      </a>
    </div>
  </section>
</Base>

<style>

  .blog-head {
    position: relative;
    background: var(--surface-alt);
    /* The head is a title, not a screen of its own. */
    padding-block: var(--s-6);
  }

  @media (min-width: 900px) {
    .blog-head {
      padding-block: var(--s-7);
    }
  }


  .blog-head h1 {
    font-size: var(--fs-h1);
    margin-block: var(--s-2) var(--s-3);
    max-width: 18ch;
  }


  .blog-head__lead {
    font-size: var(--t-base);
    color: var(--ink-600);
    max-width: 48ch;
    margin: 0;
  }


  .featured {
    display: grid;
    gap: var(--s-4);
    padding-bottom: var(--s-5);
    margin-bottom: var(--s-5);
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }


  /* The cover is capped so one featured card cannot eat a phone screen. */
  .featured__media {
    position: relative;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--brand-050);
    max-height: 22rem;
  }


  .featured__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: var(--brand-050);
    color: var(--brand-300);
  }


  .featured__badge {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    /* F5: yellow is the booking colour; this is a label. */
    background: color-mix(in srgb, var(--brand-900) 88%, transparent);
    color: var(--white);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    border-radius: var(--r-full);
  }


  .featured__meta {
    display: flex;
    gap: 0.5rem;
    font-size: var(--t-xs);
    color: var(--ink-500);
    margin-bottom: 0.5rem;
  }


  .featured h2 {
    font-size: var(--fs-h2);
    margin-bottom: var(--s-3);
  }


  .featured__body > p {
    color: var(--ink-600);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }


  .featured__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: var(--s-3);
    color: var(--brand-700);
    font-weight: 700;
    font-size: var(--t-sm);
  }


  /*
    Mobile is a list, not a stack of posters. A full-width cover on a 390px
    screen made twelve articles run to nine thousand pixels — about eleven
    screens of scrolling. From 560px the same card goes back to being a
    vertical tile with its cover on top.
  */
  .post-grid {
    display: grid;
    gap: var(--s-4);
  }


  .post-card__link {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: var(--s-3);
    align-items: start;
    text-decoration: none;
    height: 100%;
  }


  .post-card__media {
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--brand-050);
  }


  .post-card__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: var(--brand-050);
    color: var(--brand-300);
  }


  .post-card__meta {
    font-size: var(--t-xs);
    color: var(--ink-500);
    margin: 0 0 0.35rem;
  }


  .post-card h3 {
    font-size: var(--fs-h3);
    line-height: 1.22;
    margin-bottom: 0.4rem;
    color: var(--ink-900);
    transition: color var(--d-fast) linear;
  }


  .post-card__link:hover h3 {
    color: var(--brand-700);
  }


  .post-card__excerpt {
    font-size: var(--t-sm);
    color: var(--ink-600);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }


  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--border);
  }


  .pagination__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--brand-700);
    text-decoration: none;
  }


  .pagination__link :global(svg) {
    transform: rotate(180deg);
  }


  .pagination__link.is-disabled {
    visibility: hidden;
  }


  .pagination__status {
    font-size: var(--t-xs);
    color: var(--ink-500);
    text-align: center;
  }


  .blog-cta {
    display: grid;
    gap: var(--s-4);
    align-items: center;
  }


  .blog-cta h2 {
    font-size: var(--fs-h2);
    margin-bottom: var(--s-2);
  }


  .blog-cta p {
    color: var(--brand-100);
    max-width: 44ch;
    margin: 0;
  }
@media (min-width: 560px) {

    .post-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Two columns is wide enough to put the cover back on top. */
    .post-card__link {
      display: block;
    }


    .post-card__media {
      border-radius: var(--r-lg);
      margin-bottom: var(--s-3);
    }
}
@media (min-width: 900px) {

    .featured {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
    }
}
@media (min-width: 1000px) {

    .post-grid {
      grid-template-columns: repeat(3, 1fr);
    }


    .blog-cta {
      grid-template-columns: 1fr auto;
    }
}
</style>
