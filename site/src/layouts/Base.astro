---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dock from '../components/Dock.svelte';
import Tracking from '../components/Tracking.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  schemas?: Record<string, unknown>[];
  /** Transparent header over a full-bleed hero. */
  overlay?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  path,
  image,
  type,
  publishedTime,
  modifiedTime,
  noindex,
  schemas,
  overlay = false,
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#01505d" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
    <Tracking />
  </head>

  <body class:list={['has-dock', bodyClass]}>
    <a class="skip-link" href="#main">Lewati ke konten utama</a>

    <Header overlay={overlay} />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <Dock client:idle />

    <script is:inline>
      // Scroll reveal. One observer for the whole page — no framework needed.
      (function () {
        var prefersReduced = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;

        var targets = document.querySelectorAll('[data-reveal]');
        if (!targets.length) return;

        if (prefersReduced || !('IntersectionObserver' in window)) {
          targets.forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );

        targets.forEach(function (el) {
          observer.observe(el);
        });
      })();
    </script>
  </body>
</html>
