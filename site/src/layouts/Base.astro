---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dock from '../components/Dock.svelte';
import Tracking from '../components/Tracking.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  schemas?: Record<string, unknown>[];
  /** Transparent header over a full-bleed hero. */
  overlay?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  path,
  image,
  type,
  publishedTime,
  modifiedTime,
  noindex,
  schemas,
  overlay = false,
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#01505d" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://sgw.stape.au" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
    <Tracking />
  </head>

  <body class:list={['has-dock', bodyClass]}>
    <a class="skip-link" href="#main">Lewati ke konten utama</a>

    <Header overlay={overlay} />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <Dock client:idle />

    <script is:inline>
      // Scroll reveal. One observer for the whole page — no framework needed.
      (function () {
        var prefersReduced = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;

        var targets = document.querySelectorAll('[data-reveal]');
        if (!targets.length) return;

        if (prefersReduced || !('IntersectionObserver' in window)) {
          targets.forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );

        targets.forEach(function (el) {
          observer.observe(el);
        });
      })();
    </script>

    <script is:inline>
      // WhatsApp number rotation. Every click on a [data-wa] link advances a
      // round-robin cursor through the three sales numbers and rewrites the
      // wa.me target before the browser follows it, spreading the leads evenly.
      // Kept in sync with site.contact.whatsappNumbers in src/data/site.ts.
      (function () {
        var NUMS = ['6285775556783', '6282115383826', '6285294475040'];
        var KEY = 'vcv_wa_index';
        function next() {
          var i = 0;
          try { i = parseInt(localStorage.getItem(KEY) || '0', 10) || 0; } catch (e) { i = 0; }
          var num = NUMS[i % NUMS.length];
          try { localStorage.setItem(KEY, String((i + 1) % NUMS.length)); } catch (e) {}
          return num;
        }
        document.addEventListener(
          'click',
          function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[data-wa]') : null;
            if (!a) return;
            var href = a.getAttribute('href') || '';
            if (href.indexOf('wa.me/') === -1) return;
            a.href = href.replace(/wa\.me\/\d+/, 'wa.me/' + next());
          },
          false,
        );
      })();
    </script>
  </body>
</html>
