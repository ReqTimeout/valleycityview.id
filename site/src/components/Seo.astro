---
import { site } from '../data/site';
import { media } from '../lib/media';
import { webPageSchema } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  /** Path of the current page, e.g. "/blog/harga-rumah/". */
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  /** Extra JSON-LD blocks. */
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = '/media/curated/design-45.webp',
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  schemas = [],
} = Astro.props;

const canonical = new URL(path, site.origin).href;
// Resolve the image through the media manifest so the og:image always points
// at a file that really exists, and so its dimensions are correct.
const imageEntry = media(image);
const ogImage = new URL(imageEntry?.src ?? image, site.origin).href;
const ogWidth = imageEntry?.width ?? 1200;
const ogHeight = imageEntry?.height ?? 630;
const fullTitle =
  title.includes(site.name) ? title : `${title} | ${site.name}`;

/**
 * Skema dasar untuk setiap halaman yang boleh di-index. Halaman noindex tidak
 * dikirimi WebPage/BreadcrumbList: kami minta Google mengabaikannya, jadi
 * mengirim struktur untuk halaman itu hanya menambah markup kosong.
 *
 * Di sini, bukan di tiap halaman, karena halaman yang lupa merangkai skema
 * sendiri tidak akan pernah terlihat salah — ia hanya sunyi.
 */
const baseline = noindex ? [] : [webPageSchema({ title: fullTitle, description, path })];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(ogWidth)} />
<meta property="og:image:height" content={String(ogHeight)} />
<meta property="og:image:alt" content={site.description} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="geo.region" content="ID-JB" />
<meta name="geo.placename" content={site.address.city} />
<meta name="geo.position" content="-6.8210;107.5460" />
<meta name="ICBM" content="-6.8210, 107.5460" />

<link
  rel="preload"
  href="/fonts/fraunces-latin.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link rel="icon" href="/brand/icon.png" type="image/png" />
<link rel="apple-touch-icon" href="/brand/icon.png" />
<meta name="theme-color" content="#01505d" />

{
  [...baseline, ...schemas].map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
